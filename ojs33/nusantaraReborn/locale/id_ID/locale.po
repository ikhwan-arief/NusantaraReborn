msgid "plugins.themes.nusantaraReborn.option.heroCaption.label"
msgstr "Keterangan gambar hero"

msgid "plugins.themes.nusantaraReborn.option.heroDescription.description"
msgstr "Satu atau dua kalimat di bawah judul jurnal. Jika kosong, deskripsi mesin pencari jurnal yang dipakai; jika itu juga kosong, teks disembunyikan."

