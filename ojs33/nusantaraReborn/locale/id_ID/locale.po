msgid "plugins.themes.nusantaraReborn.option.featureHighlights.description"
msgstr "Hingga empat sorotan singkat di bawah deskripsi beranda, dipisahkan titik koma. Isi hanya hal yang benar untuk jurnal ini. Kosongkan untuk menyembunyikan."

