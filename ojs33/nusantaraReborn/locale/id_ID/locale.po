msgid "plugins.themes.nusantaraReborn.option.languageLabel.label"
msgstr "Bahasa jurnal"

msgid "plugins.themes.nusantaraReborn.option.nusantaraOrnaments.description"
msgstr "Aksen dekoratif halus pada hero, garis header, dan footer. Area baca (abstrak, artikel, referensi, tabel, formulir) selalu berlatar bersih."

