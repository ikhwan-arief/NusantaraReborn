msgstr "Teks hero beranda"

msgid "plugins.themes.nusantaraReborn.option.hide"
msgstr "Sembunyikan"

msgid "plugins.themes.nusantaraReborn.option.indexedIn.description"
msgstr "Satu layanan per baris, opsional diikuti | dan tautan ke rekaman jurnal. Contoh: DOAJ | https://doaj.org/toc/xxxx-xxxx. Isi hanya layanan yang benar-benar mengindeks jurnal. Kosongkan untuk menyembunyikan."

msgid "plugins.themes.nusantaraReborn.option.indexedIn.label"
msgstr "Terindeks di (footer)"

msgid "plugins.themes.nusantaraReborn.option.indexingLabel.description"
msgstr "Satu baris ringkas tentang pengindeksan yang benar-benar berlaku. Kosongkan untuk menyembunyikan baris."

msgid "plugins.themes.nusantaraReborn.option.indexingLabel.label"
msgstr "Pengindeksan (ringkas)"

msgid "plugins.themes.nusantaraReborn.option.journalTagline.description"
msgstr "Baris pendek di bawah nama jurnal pada header. Kosongkan untuk menyembunyikan."

msgid "plugins.themes.nusantaraReborn.option.journalTagline.label"
msgstr "Tagline jurnal"

msgid "plugins.themes.nusantaraReborn.option.languageLabel.description"
