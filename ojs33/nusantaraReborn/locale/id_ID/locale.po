msgid "plugins.themes.nusantaraReborn.option.peerReviewLabel.description"
msgstr "Jelaskan proses telaah sesuai kebijakan jurnal, misalnya Double-blind peer review. Kosongkan untuk menyembunyikan baris."

msgid "plugins.themes.nusantaraReborn.option.peerReviewLabel.label"
msgstr "Proses telaah"

msgid "plugins.themes.nusantaraReborn.option.publicationFrequencyLabel.description"
msgstr "Contoh: Dua kali setahun (Juni dan Desember). Kosongkan untuk menyembunyikan baris."

