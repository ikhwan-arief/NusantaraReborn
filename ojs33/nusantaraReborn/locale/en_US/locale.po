msgstr "Batik Sogan — sogan brown, ivory, copper"

msgid "plugins.themes.nusantaraReborn.option.colourScheme.description"
msgstr "Choose one of five Indonesian-inspired presets. A preset changes the palette, ornaments, default hero background and the Google font pair (when Google fonts are selected). Page structure and features stay the same."

msgid "plugins.themes.nusantaraReborn.option.colourScheme.label"
msgstr "Colour preset"

msgid "plugins.themes.nusantaraReborn.option.colourScheme.merahPutih"
msgstr "Merah Putih — red, white, charcoal"

msgid "plugins.themes.nusantaraReborn.option.colourScheme.tenunSenja"
msgstr "Tenun Senja — indigo, sand, terracotta"

msgid "plugins.themes.nusantaraReborn.option.colourScheme.zamrudKhatulistiwa"
msgstr "Zamrud Khatulistiwa — green, cream, gold"

msgid "plugins.themes.nusantaraReborn.option.editorInChiefAffiliation.label"
msgstr "Editor-in-Chief affiliation"

msgid "plugins.themes.nusantaraReborn.option.editorInChiefBio.label"
msgstr "Short Editor-in-Chief biography"

msgid "plugins.themes.nusantaraReborn.option.editorInChiefName.description"
msgstr "Leave empty to hide the Editor-in-Chief card on the homepage."

msgid "plugins.themes.nusantaraReborn.option.editorInChiefName.label"
msgstr "Editor-in-Chief name (homepage)"

msgid "plugins.themes.nusantaraReborn.option.editorInChiefPhoto.description"
msgstr "An https:// photo address. Leave empty to show an icon."

msgid "plugins.themes.nusantaraReborn.option.editorInChiefPhoto.label"
msgstr "Editor-in-Chief photo URL"

msgid "plugins.themes.nusantaraReborn.option.editorInChiefRole.description"
msgstr "If empty: Editor-in-Chief."

msgid "plugins.themes.nusantaraReborn.option.editorInChiefRole.label"
msgstr "Role label"

msgid "plugins.themes.nusantaraReborn.option.featureHighlights.description"
msgstr "Up to four short highlights under the homepage description, separated by semicolons. Only list what is true for this journal. Leave empty to hide."

msgid "plugins.themes.nusantaraReborn.option.featureHighlights.label"
msgstr "Journal highlights"

msgid "plugins.themes.nusantaraReborn.option.fontSource.description"
msgstr "System fonts load no external files. Google Fonts loads the preset font pair from fonts.googleapis.com, with system fonts as fallback."

msgid "plugins.themes.nusantaraReborn.option.fontSource.google"
msgstr "Google Fonts for the preset"

msgid "plugins.themes.nusantaraReborn.option.fontSource.label"
msgstr "Font source"

msgid "plugins.themes.nusantaraReborn.option.fontSource.system"
msgstr "System fonts (no external requests)"

msgid "plugins.themes.nusantaraReborn.option.heroCaption.description"
msgstr "Small caption in the corner of the hero, e.g. the credit for the Homepage Image. Leave empty to hide."

msgid "plugins.themes.nusantaraReborn.option.heroCaption.label"
msgstr "Hero image caption"

msgid "plugins.themes.nusantaraReborn.option.heroDescription.description"
msgstr "One or two sentences under the journal title. If empty, the journal's search engine description is used; if that is empty too, nothing is shown."

msgid "plugins.themes.nusantaraReborn.option.heroDescription.label"
msgstr "Homepage hero text"

msgid "plugins.themes.nusantaraReborn.option.hide"
msgstr "Hide"

msgid "plugins.themes.nusantaraReborn.option.indexedIn.description"
msgstr "One service per line, optionally followed by | and a link to the journal record. Example: DOAJ | https://doaj.org/toc/xxxx-xxxx. Only list services that actually index the journal. Leave empty to hide."

msgid "plugins.themes.nusantaraReborn.option.indexedIn.label"
msgstr "Indexed in (footer)"

msgid "plugins.themes.nusantaraReborn.option.indexingLabel.description"
msgstr "One short line about indexing that actually applies. Leave empty to hide the row."

msgid "plugins.themes.nusantaraReborn.option.indexingLabel.label"
msgstr "Indexing (short)"

msgid "plugins.themes.nusantaraReborn.option.journalTagline.description"
msgstr "Short line under the journal name in the header. Leave empty to hide."

msgid "plugins.themes.nusantaraReborn.option.journalTagline.label"
msgstr "Journal tagline"

msgid "plugins.themes.nusantaraReborn.option.languageLabel.description"
msgstr "If empty, the submission languages enabled in OJS are used."

msgid "plugins.themes.nusantaraReborn.option.languageLabel.label"
msgstr "Journal languages"

msgid "plugins.themes.nusantaraReborn.option.nusantaraOrnaments.description"
msgstr "Subtle decorative accents on the hero, header line and footer. Reading areas (abstract, article, references, tables, forms) always stay plain."

msgid "plugins.themes.nusantaraReborn.option.nusantaraOrnaments.label"
msgstr "Nusantara ornaments"

msgid "plugins.themes.nusantaraReborn.option.nusantaraOrnaments.off"
msgstr "Off"

msgid "plugins.themes.nusantaraReborn.option.nusantaraOrnaments.subtle"
msgstr "Subtle"

msgid "plugins.themes.nusantaraReborn.option.peerReviewLabel.description"
msgstr "Describe the review process as stated in the journal policy, e.g. Double-blind peer review. Leave empty to hide the row."

msgid "plugins.themes.nusantaraReborn.option.peerReviewLabel.label"
msgstr "Review process"

msgid "plugins.themes.nusantaraReborn.option.publicationFrequencyLabel.description"
msgstr "Example: Twice a year (June and December). Leave empty to hide the row."

msgid "plugins.themes.nusantaraReborn.option.publicationFrequencyLabel.label"
msgstr "Publication frequency"

msgid "plugins.themes.nusantaraReborn.option.publisherLine.description"
msgstr "Publisher text in the footer. If empty, the publisher from Settings > Journal is used; if that is empty too, the line is hidden."

msgid "plugins.themes.nusantaraReborn.option.publisherLine.label"
msgstr "Publisher line"

msgid "plugins.themes.nusantaraReborn.option.publisherUrl.description"
msgstr "The publisher's https:// address for the footer link and structured data. Leave empty if none."

msgid "plugins.themes.nusantaraReborn.option.publisherUrl.label"
msgstr "Publisher URL"

msgid "plugins.themes.nusantaraReborn.option.show"
msgstr "Show"

msgid "plugins.themes.nusantaraReborn.option.showCorrespondingEmail.description"
msgstr "Default: hidden. Show only when authors agreed to publish their email address."

msgid "plugins.themes.nusantaraReborn.option.showCorrespondingEmail.label"
msgstr "Corresponding author email on article pages"

msgid "plugins.themes.nusantaraReborn.option.socialInstagram.label"
msgstr "Follow us: Instagram URL"

msgid "plugins.themes.nusantaraReborn.option.socialLinkedin.label"
msgstr "Follow us: LinkedIn URL"

msgid "plugins.themes.nusantaraReborn.option.socialWebsite.label"
